{
  "$schema": "https://shinycolors.local/schemas/scproj-v2.json",
  "format": "scproj",
  "formatVersion": 2,
  "meta": {
    "id": "island_survival_rescue_01",
    "cat": "custom",
    "title": "無人島サバイバル！？〜消えたふたりと水平線のレスキュー〜",
    "titleZh": "荒岛求生！？～偷溜的两人与海平线大营救～",
    "unit": "ALSTROEMERIA × CoMETIK",
    "origin": "custom",
    "cast": [
      "hana",
      "amana",
      "haruki",
      "tenka",
      "chiyuki",
