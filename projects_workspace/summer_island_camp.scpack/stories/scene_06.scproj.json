        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_02",
        "zh": "制作人先生，我也想和大家一起珍惜这个闪耀的瞬间！",
        "speakerZh": "黛冬优子",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-beatId": "beat_1",
        "x-beatTitle": "角色登场与环境铺垫"
      }
    },
    {
      "speaker": "甘奈",
      "text": "プロデューサーさん、見て見て☆ 海がすっごく綺麗だよ！甘奈、みんなと来られて超嬉しいな♪",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_03",
        "zh": "制作人先生，快看快看☆ 大海超级漂亮哦！甘奈能和大家一起来，超开心的♪",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-beatId": "beat_1",
        "x-beatTitle": "角色登场与环境铺垫"
