      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "row_06",
