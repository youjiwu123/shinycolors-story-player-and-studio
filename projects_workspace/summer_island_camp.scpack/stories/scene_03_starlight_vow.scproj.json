        "x-beatTitle": "轮流说出公演目标与欢声笑语"
      }
    },
    {
      "speaker": "羽那",
      "text": "えっ、ほんとですか！？ さすがプロデューサーさんです！あたしもいーっぱいお手伝いしちゃいますね！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
