    {
      "speaker": "愛依",
      "text": "んぅ……朝かぁ。……って、あれ？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile1",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile_s",
      "lip": "lip_smile_s",
      "_meta": {
        "uid": "r01",
        "zh": "嗯唔……早上了呀。……咦，等等？",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "[揉着眼睛从被子里坐起身，视线迷糊地扫过陌生的和室]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "愛依",
      "text": "えっ、ちょっと待って……プロデューサー！？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "r02",
        "zh": "哎，等一下……制作人！？",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[看清门口角落的被褥后猛地捂住嘴，压低声音惊呼]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛",
        "stageAction": "awkward_pause"
      },
      "waitType": "time",
      "waitTime": 650
    },
    {
      "speaker": "プロデューサー",
      "text": "ん……おはよう、愛依。もうそんな時間か。",
      "textFrame": "001",
      "textCtrl": "p",
      "_meta": {
        "uid": "r03",
        "zh": "嗯……早啊，爱依。已经这个时间了吗。",
        "speakerZh": "制作人",
        "note": "[听到动静后睁开眼，靠墙坐起身揉了揉后颈]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "愛依",
      "text": "お、おはよ……ってか、えっと、その……！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "shy1",
      "charAnim2": "face_shy",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "r04",
        "zh": "早、早安……那个，不对，就是……！",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "note": "[视线慌乱地飘向天花板，平时爽朗的语气一下结巴起来]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "愛依",
      "text": "同じ部屋って、朝になるとマジでヤバくない！？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "shy1",
      "charAnim2": "face_shy",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "r05",
        "zh": "同住一间房这种事，一到早上岂不是超不妙的吗！？",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "note": "[抱着膝盖缩在被窝里，脸颊一下红透]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "プロデューサー",
      "text": "あぁ……部屋が一つしか空いてなかったからな。",
      "textFrame": "001",
      "textCtrl": "p",
      "_meta": {
        "uid": "r06",
        "zh": "啊……毕竟昨晚旅馆只剩这一间空房了。",
        "speakerZh": "制作人",
        "note": "[略显局促地抓了抓头发，目光礼貌地移开]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "愛依",
      "text": "そ、そりゃそうなんだけどさぁ……うぅっ！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "shy1",
      "charAnim2": "face_shy",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "r07",
        "zh": "话、话是这么说没错啦……呜呜！",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "note": "[把被子往上拉到鼻尖，只露出一双眼睛眨呀眨]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "愛依",
      "text": "なんでもないっ！……いや、ちょっと照れるじゃん！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "shy1",
      "charAnim2": "face_shy",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "r08",
        "zh": "没什么啦！……不对，果然还是会有点害羞嘛！",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "note": "[嘴硬完又忍不住闷声补了一句真心话]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
    },
    {
      "speaker": "プロデューサー",
      "text": "はは……入口側の隅っこにいたから勘弁してくれ。",
      "textFrame": "001",
      "textCtrl": "p",
      "_meta": {
        "uid": "r09",
        "zh": "哈哈……我一直老实待在门口最角落里，就饶了我吧。",
        "speakerZh": "制作人",
        "note": "[苦笑着拍了拍离她们最远的门边被褥]",
        "x-beatId": "beat_1",
        "x-beatTitle": "清早醒来的微妙气氛"
      }
