      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "r15",
        "zh": "对、对哦！这是紧急避险，紧急避险！",
        "speakerZh": "黛冬优子",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "[像是要说服自己一般连连点头，强行端起架子]",
