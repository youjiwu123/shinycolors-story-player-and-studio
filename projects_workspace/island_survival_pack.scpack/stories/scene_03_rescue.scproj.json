    {
      "speaker": "甜花",
      "text": "なーちゃん……！無事でよかったぁ……！甜花、心配でずっと胸がドキドキしてたの……！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "tenka",
      "charType": "characters",
      "charId": "015",
      "clothId": "015",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "s3_r04",
        "zh": "甘奈酱……！平安无事真是太好了……！甜花因为太担心，心一直扑通扑通跳个不停……！",
        "speakerZh": "大崎甜花",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[机位B: 甘奈/甜花/羽那 3人同台] 自动淡出前3人，切入荒岛重逢组",
        "x-beatId": "beat_2",
        "x-beatTitle": "荒岛重逢组姐妹相拥报平安"
      }
    },
    {
      "speaker": "甘奈",
      "text": "甜花ちゃん、ごめんね☆ でもプロデューサーさんと羽那ちゃんが一緒で、甘奈ぜんぜん平気だったよ♪",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r05",
        "zh": "甜花酱，对不起让你担心啦☆ 不过有制作人先生和羽那酱在一起，甘奈完全没事哟♪",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-beatId": "beat_2",
        "x-beatTitle": "荒岛重逢组姐妹相拥报平安"
      }
    },
    {
      "speaker": "羽那",
      "text": "えへへ、真乃さんたちも甜花さんも、迎えに来てくれてありがとうございます！あたし感激です～！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 896,
        "y": 610,
        "order": 2
      },
      "charScale": 1,
      "charAnim1": "smile2",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r06",
        "zh": "嘿嘿，真乃小姐她们还有甜花小姐，谢谢大家赶来接我们！我真的太感动啦～！",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "smile_gentle",
        "innerEmotion": "performative_sweet",
        "vocalTone": "sweet_performative",
        "x-beatId": "beat_2",
        "x-beatTitle": "荒岛重逢组姐妹相拥报平安"
      }
    },
    {
      "speaker": "甜花",
      "text": "にへへ……プロデューサーさん、ふたりを守ってくれてありがとう……。帰ったらアイス食べよ……♪",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "tenka",
      "charType": "characters",
      "charId": "015",
      "clothId": "015",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r07",
        "zh": "嘿嘿……谢谢制作人先生保护了她们两位……。回去之后，大家一起吃冰淇淋吧……♪",
        "speakerZh": "大崎甜花",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-beatId": "beat_2",
        "x-beatTitle": "荒岛重逢组姐妹相拥报平安"
      }
