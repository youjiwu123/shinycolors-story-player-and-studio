    {
      "speaker": "真乃",
      "text": "ふふっ、夕焼けの海が綺麗ですね……！プロデューサーさん、みんなで帰れるのが一番の宝物ですっ。",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mano",
      "charType": "characters",
      "charId": "001",
      "clothId": "001",
      "charCategory": "stand",
      "charPosition": {
        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile2",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r08",
        "zh": "呵呵，夕阳下的大海真漂亮呀……！制作人先生，大家能像这样一起回家，就是最珍贵的宝物了。",
        "speakerZh": "樱木真乃",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
