    {
      "speaker": "真乃",
      "text": "プロデューサーさん、甘奈ちゃん、羽那ちゃん！よかったぁ……わたしたち、ずっと探していたんですっ！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mano",
      "charType": "characters",
      "charId": "001",
      "clothId": "001",
      "charCategory": "stand",
      "charPosition": {
        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_trouble",
      "lip": "lip_trouble",
      "_meta": {
        "uid": "s3_r01",
        "zh": "制作人先生、甘奈酱、羽那酱！太好了……我们一直在到处找大家呢！",
        "speakerZh": "樱木真乃",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[机位A: 真乃/灯织/缭 3人同台] 救援小队靠岸登场",
        "x-beatId": "beat_1",
        "x-beatTitle": "救援艇靠岸与3人救援组呼喊"
      }
    },
    {
      "speaker": "灯織",
      "text": "プロデューサー、怪我はありませんか？真乃、めぐる、まずは冷たい水とタオルを渡しましょう。",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hiori",
      "charType": "characters",
      "charId": "002",
      "clothId": "002",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "wait1",
      "charAnim2": "face_serious",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r02",
        "zh": "制作人，大家没有受伤吧？真乃、缭，先把冰水和毛巾递给她们两位吧。",
        "speakerZh": "风野灯织",
        "surfaceEmotion": "calm_neutral",
        "innerEmotion": "resolve_quiet",
        "vocalTone": "calm_even",
        "x-beatId": "beat_1",
        "x-beatTitle": "救援艇靠岸与3人救援组呼喊"
      }
    },
    {
      "speaker": "めぐる",
      "text": "おーいっ！砂浜の合図、船からでもすっごく目立ってたよ！無事でよかったね、プロデューサー！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "meguru",
      "charType": "characters",
      "charId": "003",
      "clothId": "003",
      "charCategory": "stand",
      "charPosition": {
        "x": 896,
        "y": 610,
        "order": 2
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s3_r03",
        "zh": "喂——！沙滩上的信号，就算在船上也超级显眼哦！大家平安无事真是太好啦，制作人！",
        "speakerZh": "八宫巡",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-beatId": "beat_1",
        "x-beatTitle": "救援艇靠岸与3人救援组呼喊"
      }
    },
