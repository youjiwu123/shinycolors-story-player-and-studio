      "lip": "lip_smile",
      "_meta": {
        "uid": "s2_r06",
        "zh": "啊，船上的探照灯亮起来了！制作人先生，甘奈我们的信号已经稳稳传过去了呢☆",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "smile_gentle",
        "innerEmotion": "performative_sweet",
        "vocalTone": "sweet_performative",
        "note": "[汇合: signal_success] 搜救船回应信号",
        "x-beatId": "beat_3",
        "x-beatTitle": "探照灯回应与海风欢呼"
      }
