      "text": "えへへ、プロデューサーさんが笑ってくれると、あたしまでぽかぽかしちゃいます！一緒に頑張りましょうね！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
