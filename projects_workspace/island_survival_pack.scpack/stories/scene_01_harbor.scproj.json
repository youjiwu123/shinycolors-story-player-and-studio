    {
      "speaker": "羽那",
      "text": "わあ……！　海がキラキラしてて、綺麗だねーっ",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_01",
        "zh": "哇……！大海闪闪发光的，好漂亮啊—",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "[小段: 偷溜登岛与游艇离开] [踏上细腻的白沙，羽那睁大双眼欢喜地望向碧蓝海面]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开"
      }
    },
    {
      "speaker": "甘奈",
      "text": "うんっ☆　少しだけのつもりが、素敵な島に来ちゃったね～",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 360,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_02",
        "zh": "嗯☆ 本来只是想稍微坐一下，结果来到这么棒的岛上了呢～",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "[甘奈笑着拨开被海风吹乱的发丝，环顾四周翠绿的椰林]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开"
      }
    },
    {
      "speaker": "羽那",
      "text": "あれ……？　甘奈ちゃん、あのボート行っちゃった？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "row_03",
        "zh": "哎……？甘奈，那艘快艇是不是开走了呀？",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[羽那忽然回过头望向身后，歪着脑袋伸手指向渐渐远去的小艇]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开"
      }
    },
    {
      "speaker": "甘奈",
      "text": "えっ！？　待ってーっ！　まだここにいるよーっ！？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 360,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "row_04",
        "zh": "哎！？等、等一下啊！我们还在岛上呢——！？",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[甘奈瞬间睁大眼睛，慌忙跑到浪花边用力挥舞双手大喊]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开",
        "stageAction": "flash_shock"
      },
      "bg": "00269",
      "bgEffect": "white_fade",
      "bgEffectTime": 260
    },
    {
      "speaker": "羽那",
      "text": "えーっ、ほんとだー……気づいてないみたいだね",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "row_05",
        "zh": "哎——真的呢……好像完全没有发现我们呀。",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "note": "[目送着快艇变成海平线上的一个小黑点，羽那轻轻眨了眨眼]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开"
      }
    },
    {
      "speaker": "甘奈",
      "text": "大丈夫だよ羽那ちゃん☆　すぐ連絡を……って、あれ……？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 360,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "wait3",
      "charAnim2": "face_close",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_trouble",
      "lip": "lip_trouble",
      "_meta": {
        "uid": "row_06",
        "zh": "没事的哦羽那☆ 马上就联系……咦、怎么会……？",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "troubled_sigh",
        "innerEmotion": "guarded_distance",
        "vocalTone": "sigh_trail",
        "note": "[甘奈强撑着露出笑容举起手机，手指却在看到无信号时僵住了]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开",
        "stageAction": "awkward_pause",
        "holdMs": 650
      }
    },
    {
      "speaker": "羽那",
      "text": "ふふ、あたしたち二人っきりになっちゃったねー",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_07",
        "zh": "呼呼，这下变成只有我们两个人了呢—",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "[羽那丝毫没有慌张，迎着暖洋洋的海风朝甘奈露出了澄澈的笑容]",
        "x-beatId": "beat_1",
        "x-beatTitle": "偷溜登岛与游艇离开"
      }
    },
    {
      "speaker": "プロデューサー",
      "text": "ふたりとも無事でよかった……！迎えの船が来るまで、ヤシの葉で日陰を作って休もう。",
      "textFrame": "001",
      "textCtrl": "p",
      "_meta": {
        "uid": "row_08",
        "zh": "你们两个都平安无事真是太好了……！在救援船赶来之前，我们先用椰叶搭个遮阳棚休息吧。",
        "speakerZh": "制作人",
        "note": "[节拍 2] 制作人赶到，提议搭建树叶遮阳棚",
        "x-beatId": "beat_2",
        "x-beatTitle": "与制作人合力搭椰叶棚"
      }
    },
    {
      "speaker": "甘奈",
      "text": "あっ、正午の日差しがジリジリしてきたかも！プロデューサーさん、甘奈も葉っぱ集めてくるね☆",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 360,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "surp1",
      "charAnim2": "face_surp",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_surp",
      "lip": "lip_surp",
      "_meta": {
        "uid": "row_09",
        "zh": "啊，正午的阳光变得火辣辣的了！制作人先生，甘奈也去帮忙收集大椰子叶哦☆",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "surprise_wide",
        "innerEmotion": "alert_spark",
        "vocalTone": "bright_pop",
        "manualPos": true,
        "x-beatId": "beat_2",
        "x-beatTitle": "与制作人合力搭椰叶棚"
      }
    },
    {
      "speaker": "羽那",
      "text": "あたしも行きますっ！大きな葉っぱを重ねたら、秘密基地みたいで絶対楽しいですよ～！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "yes",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "row_10",
        "zh": "我也要去！要是把大大的叶子叠起来，肯定像秘密基地一样超有趣的哦～！",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "smile_gentle",
        "innerEmotion": "performative_sweet",
        "vocalTone": "sweet_performative",
        "manualPos": true,
        "x-beatId": "beat_2",
        "x-beatTitle": "与制作人合力搭椰叶棚"
      }
    },
    {
      "speaker": "甘奈",
      "text": "えへへ、テント完成☆ あっ、羽那ちゃんの肩が赤くなってる！甘奈の日焼け止め、一緒に塗ろっか♪",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "amana",
      "charType": "characters",
      "charId": "014",
      "clothId": "014",
      "charCategory": "stand",
      "charPosition": {
        "x": 360,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "shy1",
      "charAnim2": "face_shy",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "row_11",
        "zh": "嘿嘿，树叶帐篷完成啦☆ 啊，羽那酱的肩膀有点晒红了！来用甘奈的防晒霜，我们一起涂吧♪",
        "speakerZh": "大崎甘奈",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "manualPos": true,
        "note": "[节拍 3] 正午防晒互动，苦中作乐",
        "x-beatId": "beat_3",
        "x-beatTitle": "正午晒红肩膀与涂防晒霜"
      }
    },
    {
      "speaker": "羽那",
      "text": "わぁ、ありがとうございます甘奈さん！プロデューサーさんも隣でちゃんと涼んでくださいね！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hana",
      "charType": "characters",
      "charId": "027",
      "clothId": "027",
      "charCategory": "stand",
      "charPosition": {
        "x": 776,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "shy2",
      "charAnim2": "face_shy",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_shy",
      "lip": "lip_shy",
      "_meta": {
        "uid": "row_12",
        "zh": "哇，谢谢甘奈小姐！制作人先生也要在我们身边好好乘凉休息哦！",
        "speakerZh": "铃木羽那",
        "surfaceEmotion": "shy_flustered",
        "innerEmotion": "affection_bashful",
        "vocalTone": "breath_flutter",
        "manualPos": true,
        "x-beatId": "beat_3",
        "x-beatTitle": "正午晒红肩膀与涂防晒霜"
      }
