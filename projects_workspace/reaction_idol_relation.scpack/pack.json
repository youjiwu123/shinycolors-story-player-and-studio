    {
      "cardId": "react_luca",
      "charLabel": "luca",
      "style": "canon",
      "bg": "00003",
      "bgm": "0018",
      "outfitKey": "characters/stand/026",
      "charType": "characters",
      "charCategory": "stand",
      "charId": "026",
      "clothId": "026",
      "stageSummary": "初反应冷笑“少说废话” → 烦躁斥责“别拿框框套我” → 别扭独占“只准看着我的舞台”",
      "lines": [
        {
          "lineId": "luca_1",
          "emotion": "tsun",
          "anim1": "anger1",
          "anim2": "face_anger",
          "se": "",
          "text": "……は？プロデューサー、今さら何当たり前のこと言ってんだよ。",
          "zh": "……哈？制作人，都这时候了你还在说什么理所当然的废话啊。",
          "note": "[初反应] 皱眉冷笑一声"
        },
        {
          "lineId": "luca_2",
          "emotion": "serious",
          "anim1": "no",
          "anim2": "face_serious",
          "se": "bgm_stop",
          "text": "勝手に線引きしてんじゃねェよ……私はアンタのお人形じゃねェんだからな。",
          "zh": "少在那里擅自划清界限了……我可不是任你摆布的洋娃娃。",
          "note": "[反转凌厉] 眼神锋利地逼视制作人"
        },
        {
          "lineId": "luca_3",
          "emotion": "sigh",
          "anim1": "wait3",
          "anim2": "face_close",
          "se": "",
          "text": "……チッ、いいから黙って私のステージだけ見てろよ、プロデューサー。",
          "zh": "……啧，少啰嗦，你就闭上嘴乖乖只看着我的舞台就够了，制作人。",
          "note": "[傲娇独占] 压低帽檐转过身去"
        }
      ]
    },
    {
      "cardId": "react_hana",
      "charLabel": "hana",
      "style": "sweet",
      "bg": "00105",
      "bgm": "0016",
      "outfitKey": "characters/stand/027",
      "charType": "characters",
      "charCategory": "stand",
      "charId": "027",
      "clothId": "027",
      "stageSummary": "初反应天然歪头眨眼 → 零防备超直球“全世界最特别的人” → 灿烂贴近",
      "lines": [
        {
          "lineId": "hana_1",
          "emotion": "surp",
          "anim1": "surp1",
          "anim2": "face_surp",
          "se": "",
          "text": "えっ……？プロデューサーさん、急にかしこまってどうしちゃったんですか？",
          "zh": "咦……？制作人先生，怎么突然这么一本正经呀？",
          "note": "[初反应] 纯真地歪了歪脑袋"
        },
        {
          "lineId": "hana_2",
          "emotion": "joy",
          "anim1": "smile2",
          "anim2": "face_smile",
          "se": "0453",
          "text": "あたしにとっては、プロデューサーさんは世界で一番特別なプロデューサーさんですよ～！",
          "zh": "但在我心里，制作人先生就是全世界最最特别的制作人先生哦～！",
          "note": "[直球暴击] 毫无防备的零距离天然直球"
        },
        {
          "lineId": "hana_3",
          "emotion": "idol",
          "anim1": "yes",
          "anim2": "face_smile",
          "se": "0478",
          "text": "えへへ、これからもずーっと、あたしの隣で見ててくださいね、プロデューサーさんっ！",
          "zh": "嘿嘿，今后也请一直一直留在我的身边注视着我哦，制作人先生！",
          "note": "[甜度拉满] 双眼发亮地开心挥手"
        }
      ]
    },
