    {
      "cardId": "react_madoka",
      "charLabel": "madoka",
      "style": "canon",
      "bg": "00001",
      "bgm": "0018",
      "outfitKey": "characters/stand/021",
      "charType": "characters",
      "charCategory": "stand",
      "charId": "021",
      "clothId": "021",
      "stageSummary": "初反应冷淡附和“纯商业伙伴” → 眼神微冷毒舌反刺 → 轻轻叹气动摇",
      "lines": [
        {
          "lineId": "madoka_1",
          "emotion": "serious",
          "anim1": "wait1",
          "anim2": "face_serious",
          "se": "",
          "text": "ええ、そうですね。プロデューサーとアイドル、ただのビジネスパートナーですから。",
          "zh": "嗯，是那样没错呢。制作人和偶像，本来就只是纯粹的商业搭档而已。",
          "note": "[初反应] 波澜不惊地冷淡附和"
        },
        {
          "lineId": "madoka_2",
          "emotion": "sigh",
          "anim1": "wait3",
          "anim2": "face_close",
          "se": "bgm_stop",
          "text": "……わざわざ口に出して線を引くなんて、プロデューサー、何か後ろめたいことでも？",
          "zh": "……特意说出口来划清界限，制作人，您是有什么心虚的事吗？",
          "note": "[反转刺探] 半眯起眼冷冷盯住制作人"
        },
        {
          "lineId": "madoka_3",
          "emotion": "shy",
          "anim1": "wait2",
          "anim2": "face_shy",
          "se": "",
          "text": "ふーん……まあ、私は最初から期待なんてしていませんけど。",
          "zh": "哼……算了，反正我从一开始就没有抱什么多余的期待就是了。",
          "note": "[余韵收尾] 微微移开目光轻声嘟囔"
        }
      ]
    },
    {
      "cardId": "react_koito",
      "charLabel": "koito",
      "style": "canon",
      "bg": "00003",
      "bgm": "016",
      "outfitKey": "characters/stand/022",
      "charType": "characters",
      "charCategory": "stand",
      "charId": "022",
      "clothId": "022",
      "hairKey": "same",
      "charHair": "",
      "lines": [
