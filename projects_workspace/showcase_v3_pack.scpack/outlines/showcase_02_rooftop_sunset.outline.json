      "beatTitle": "四人集结分镜切换",
      "charLabel": "hinana",
      "emotion": "idol",
      "filter": "dusk",
      "text": "お待たせ〜！ 小糸ちゃんたち、すっごく絵になる風景の中にいるね〜♪",
      "zh": "久等啦～！小糸你们，正站在像画一样的风景里呢～♪",
      "note": "第四位成员雏菜发言，触发自动 3 人上限分镜切机位",
      "speaker": "雛菜",
      "ooc": {
        "ok": true,
        "status": "pass",
        "flags": [],
        "issues": []
      }
    },
