    {
      "speaker": "雛菜",
      "text": "お待たせ〜！ 小糸ちゃんたち、すっごく絵になる風景の中にいるね〜♪",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hinana",
      "charType": "characters",
      "charId": "023",
      "clothId": "023",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile2",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile1",
      "lip": "lip_smile1",
      "_meta": {
        "uid": "s2_05",
        "zh": "久等啦～！小糸你们，正站在像画一样的风景里呢～♪",
        "speakerZh": "市川雏菜",
        "surfaceEmotion": "smile_gentle",
        "innerEmotion": "performative_sweet",
        "vocalTone": "sweet_performative",
        "x-editor-filter": "dusk",
        "note": "第四位成员雏菜发言，触发自动 3 人上限分镜切机位",
        "x-beatId": "beat_2",
        "x-beatTitle": "四人集结分镜切换"
      }
    },
    {
      "speaker": "雛菜",
      "text": "やっぱみんなで帰るの、しあわせ〜！ ねぇ、透先輩、コンビニ寄ってく〜？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "hinana",
      "charType": "characters",
      "charId": "023",
      "clothId": "023",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile1",
      "lip": "lip_smile1",
      "_meta": {
        "uid": "s2_06",
        "zh": "果然大家一起回家好幸福呀～！呐，透前辈，待会顺路去便利店吗～？",
        "speakerZh": "市川雏菜",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-editor-filter": "dusk",
        "note": "雏菜笑眯眯邀约",
        "x-beatId": "beat_2",
        "x-beatTitle": "四人集结分镜切换"
      }
    },
