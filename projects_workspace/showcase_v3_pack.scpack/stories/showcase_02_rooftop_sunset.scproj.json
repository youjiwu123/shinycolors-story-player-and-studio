    {
      "speaker": "透",
      "text": "いいね。じゃあ、冷たいやつ買おっか。みんなもそれでいい？",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "tooru",
      "charType": "characters",
      "charId": "020",
      "clothId": "020",
      "charCategory": "stand",
      "charPosition": {
        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim2": "face_smile1",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s2_07",
        "zh": "不错啊。那去买冰饮吧。大家都没意见？",
        "speakerZh": "浅仓透",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-editor-filter": "dusk",
        "note": "透转回镜头，自动切回第一机位",
        "x-beatId": "beat_3",
        "x-beatTitle": "风里的独白"
      }
    },
    {
      "speaker": "円香",
      "text": "（……騒がしくて、落ち着かない人たち。……でも、この色だけは嘘じゃない）",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "madoka",
      "charType": "characters",
      "charId": "021",
      "clothId": "021",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim2": "face_serious",
      "charAnim4": "eye_left",
      "charLipAnim": "lip_wait_s",
      "lip": "lip_wait_s",
      "_meta": {
        "uid": "s2_08",
        "zh": "（……真是吵闹又让人静不下来的一群人。……但唯有眼前的暮色，并非虚假。）",
        "speakerZh": "樋口円香",
        "surfaceEmotion": "calm_neutral",
        "innerEmotion": "resolve_quiet",
        "vocalTone": "calm_even",
        "x-innerMonologue": true,
        "x-editor-filter": "dusk",
        "note": "円香心中独白，闭口帧表现",
        "x-beatId": "beat_3",
        "x-beatTitle": "风里的独白"
      }
    },
    {
      "speaker": "小糸",
      "text": "はいっ！ 小糸、あたたかいココアにしようかな……それとも冷たいの！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "koito",
      "charType": "characters",
      "charId": "022",
      "clothId": "022",
      "charCategory": "stand",
      "charPosition": {
        "x": 896,
        "y": 610,
        "order": 2
      },
      "charScale": 1,
      "charAnim2": "face_smile",
      "charAnim4": "eye_left",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s2_09",
        "zh": "嗯！小糸要不要选热可可呢……还是也选冰饮好呢！",
        "speakerZh": "福丸小糸",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "x-editor-filter": "dusk",
        "note": "福丸小糸元气收尾（保留“小糸”）",
        "x-beatId": "beat_3",
        "x-beatTitle": "风里的独白"
      }
