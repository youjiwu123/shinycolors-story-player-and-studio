    {
      "speaker": "冬優子",
      "text": "あ、プロデューサーさんっ！ ふゆ、みんなの分のスイーツを買ってきちゃいました♡",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "fuyuko",
      "charType": "characters",
      "charId": "018",
      "clothId": "018",
      "charCategory": "stand",
      "charPosition": {
        "x": 240,
        "y": 610,
        "order": 0
      },
      "charScale": 1,
      "charAnim1": "smile2",
      "charAnim2": "face_smile",
      "charAnim4": "eye_front",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s1_01",
        "zh": "啊，制作人先生！冬优连大家的份一起把甜点买回来了哦♡",
        "speakerZh": "黛冬优子",
        "surfaceEmotion": "smile_gentle",
        "innerEmotion": "performative_sweet",
        "vocalTone": "sweet_performative",
        "note": "冬优子甜美营业开场",
        "x-beatId": "beat_1",
        "x-beatTitle": "冬优子的下午茶营业"
      }
    },
    {
      "speaker": "愛依",
      "text": "わあ、さすが冬優子ちゃんっ！ めっちゃ美味しそうじゃん！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "mei",
      "charType": "characters",
      "charId": "019",
      "clothId": "019",
      "charCategory": "stand",
      "charPosition": {
        "x": 896,
        "y": 610,
        "order": 2
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile1",
      "charAnim4": "eye_left",
      "charLipAnim": "lip_smile1",
      "lip": "lip_smile1",
      "_meta": {
        "uid": "s1_02",
        "zh": "哇，不愧是冬优子！看起来也太好吃了吧！",
        "speakerZh": "和泉爱依",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "爱依开心捧场",
        "x-beatId": "beat_1",
        "x-beatTitle": "冬优子的下午茶营业"
      }
    },
    {
      "speaker": "あさひ",
      "text": "あ、本当っすね！ でもあたし、冷蔵庫の奥にもっとすごいプリン見つけたっす！",
      "textFrame": "001",
      "textCtrl": "p",
      "charLabel": "asahi",
      "charType": "characters",
      "charId": "017",
      "clothId": "017",
      "charCategory": "stand",
      "charPosition": {
        "x": 568,
        "y": 610,
        "order": 1
      },
      "charScale": 1,
      "charAnim1": "smile1",
      "charAnim2": "face_smile",
      "charAnim4": "eye_right",
      "charLipAnim": "lip_smile",
      "lip": "lip_smile",
      "_meta": {
        "uid": "s1_03",
        "zh": "啊，真的耶！不过我在冰箱最里面发现了看起来更厉害的布丁！",
        "speakerZh": "芹泽朝日",
        "surfaceEmotion": "joy_bright",
        "innerEmotion": "trust_warm",
        "vocalTone": "warm_soft",
        "note": "朝日好奇凑近冰箱",
        "x-beatId": "beat_1",
        "x-beatTitle": "冬优子的下午茶营业",
